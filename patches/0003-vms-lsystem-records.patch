Subject: lsystem.c: on OpenVMS, end the command's last line before "!done"

VMS writes a command's output to the terminal as records: a line feed,
the text, a carriage return.  After "!show time" the cursor was back at
the start of the time's line, and less's "!done (press RETURN)" was
written over it.  On VMS less does not end the echoed command line
itself (the first record's line feed does that) and ends the last line
after the command.

--- a/lsystem.c	2026-09-09 02:42:37.000000000 +0100
+++ b/lsystem.c	2026-10-10 10:23:04.746619325 +0100
@@ -65,7 +65,9 @@
 		clear_bot();
 		putstr("!");
 		putstr(cmd);
+#ifndef __VMS
 		putstr("\n");
+#endif
 	}
 
 #if MSDOS_COMPILER
@@ -161,6 +163,15 @@
 			p = save(cmd);
 	}
 	system(p);
+#ifdef __VMS
+	/*
+	 * VMS writes the command's output as records (LF, text, CR), so the
+	 * first one starts its own line and the last leaves the cursor at the
+	 * start of its line: end that line before less writes "!done".
+	 */
+	fputs("\r\n", stdout);
+	fflush(stdout);
+#endif
 	free(p);
 #else
 #if MSDOS_COMPILER==DJGPPC
