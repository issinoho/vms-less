@@ -180,6 +187,10 @@
  */
 public lbool ttyin_ready(void)
 {
+#if defined __VMS
+	/* The terminal driver's type-ahead count (vms/vms_tty.c). */
+	return vms_tty_ready() ? TRUE : FALSE;
+#endif
 #if MSDOS_COMPILER==WIN32C
 	return win32_kbhit();
 #else
--- a/output.c	2026-09-09 02:42:37.000000000 +0100
+++ b/output.c	2026-10-10 10:07:09.743054539 +0100
@@ -13,6 +13,9 @@
  */
 
 #include "less.h"
+#ifdef __VMS
