! DESCRIP.MMS - build less for OpenVMS (IA64, x86-64)
!
! Run from the top of the prepared source tree via [.VMS]BUILD.COM, which
! passes ARCH (IA64 or X86_64) and creates the output directories.  Source
! lists and per-object rules come from [.VMS]SOURCES.MMS, generated by
! tools/prepare.sh: SRC_OBJS is less (the Makefile's OBJ), EXTRA_OBJS the
! VMS sources.  less has no library of its own and no gnulib.

.IFDEF ARCH
.ELSE
ARCH = IA64
.ENDIF

OBJ = [.OBJ_$(ARCH)]
LOBJ = [.OBJ_$(ARCH).LIB]
BIN = [.BIN_$(ARCH)]

.INCLUDE [.VMS]SOURCES.MMS

CC = CC
! SYSDIR: where less looks for the system-wide lesskey file (less's Makefile
! passes it with -D): LESS$ROOT:[000000]sysless.  BINDIR and LIBEXECDIR are
! optional and not used (lessecho is not built).  exit=vms_exit gives
! failures error severity under DCL (vms/vms_exit.c).
CFLAGS = $(CC_QUAL)/NOLIST/INCLUDE_DIRECTORY=("./","./vms")-
	/DEFINE=($(CC_DEFS),HAVE_CONFIG_H,"exit=vms_exit","SYSDIR=""/LESS$ROOT""")

ALL : $(BIN)LESS.EXE
	@ CONTINUE

! "-": LINK ends with a warning status (%ILINK-W-COMPWARN) when modules
! compiled with VSI C's benign warnings; tools/build.sh fails the build on
! real link errors and undefined symbols.
$(BIN)LESS.EXE : $(SRC_OBJS), $(EXTRA_OBJS)
	- LINK/EXECUTABLE=$(MMS$TARGET)/MAP=$(OBJ)LESS.MAP/FULL $(SRC_OBJS), $(EXTRA_OBJS)

CLEAN :
	IF F$SEARCH("$(OBJ)*.OBJ") .NES. "" THEN DELETE/NOLOG $(OBJ)*.OBJ;*,*.MAP;*
	IF F$SEARCH("$(BIN)*.*") .NES. "" THEN DELETE/NOLOG $(BIN)*.*;*
